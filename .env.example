# Canonical list of environment variables. Copy to .env.local and fill in.
# Only NEXT_PUBLIC_* values reach the browser. Everything else is server-only.

# Clerk (https://dashboard.clerk.com → API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Neon Postgres (written by `neon checkout` / `neon env pull`)
# Pooled connection (host has -pooler): used by the app through lib/db.ts.
DATABASE_URL=
# Direct connection (no -pooler): used by the Prisma CLI for migrations.
DATABASE_URL_UNPOOLED=
# Name of the Neon branch these URLs point to (dev for local work, never production).
NEON_BRANCH=

# Clerk webhook (Dashboard → Webhooks → endpoint /api/webhooks/clerk → Signing secret)
CLERK_WEBHOOK_SIGNING_SECRET=

# Free plan limits (server-enforced). Empty = defaults: 3 documents, 50 flashcards, 2 quizzes / 7 days.
FREE_MAX_DOCUMENTS=
FREE_MAX_FLASHCARDS=
FREE_MAX_QUIZZES_PER_WEEK=
FREE_MAX_CREATIONS_PER_WEEK=

# Billing. "mock" (default until Lemon Squeezy is connected) = the Billing page's test checkout,
# which charges nothing. The mock is refused on a production deployment (VERCEL_ENV=production)
# unless BILLING_MOCK_IN_PRODUCTION=true. Display prices (no numbers in components):
BILLING_PROVIDER=mock
BILLING_MOCK_IN_PRODUCTION=
PRICE_PRO_MONTHLY=7
PRICE_PRO_YEARLY=49
PRICE_PASS=15
PRICE_CURRENCY=USD

# Lemon Squeezy (later). Keep test and live values apart: "true" (default) uses test-mode rows only.
LEMONSQUEEZY_TEST_MODE=true
LEMONSQUEEZY_VARIANT_PRO_MONTHLY=
LEMONSQUEEZY_VARIANT_PRO_YEARLY=
LEMONSQUEEZY_VARIANT_PASS=

# Neon Object Storage (written by `neon deploy` / `neon env pull` for the linked branch). Server-only.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
# Private bucket for course files (declared in neon.ts).
STORAGE_BUCKET=course-files
# Largest single upload per plan, in MB.
FREE_MAX_FILE_MB=
PRO_MAX_FILE_MB=
# Public URL of the deployed app (bucket CORS rule via `npm run storage:cors`, and the links in reminder emails).
APP_URL=

# Inngest (background jobs). Locally: `npm run inngest` (dev server, no keys needed).
# Production: from the Inngest dashboard. Server-only.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Set to 1 to force dev mode (talk to the local Inngest dev server).
INNGEST_DEV=

# Processing caps per plan (pages or slides read from one file).
FREE_MAX_PAGES=
PRO_MAX_PAGES=

# Providers. "mock" (default) until the real services are connected.
PARSER=local
OCR_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini

# AI: Google Gemini (server-only key). Providers default to "gemini" when GEMINI_API_KEY is set; "mock" works offline.
# ⚠ FREE TIER: Google may use requests (course text, photos, answers) to improve its products.
#   OK for development with your own files only — use a PAID project key before real students.
GEMINI_API_KEY=
AI_PROVIDER=gemini
# Model names live in env, not code (AGENTS.md §7): fast = summaries/flashcards/quizzes/OCR, smart = grading/chat.
AI_MODEL_FAST=gemini-3.5-flash-lite
# Free tier: gemini-3.8-flash took ~156 s per call (flash-lite ~1 s), so both use flash-lite for now.
# With a paid key, set AI_MODEL_SMART=gemini-3.8-flash for better grading/chat.
AI_MODEL_SMART=gemini-3.5-flash-lite
# 1536 dims (matches the Chunk.embedding column). Changing it → run `npm run reembed`.
EMBEDDING_MODEL=gemini-embedding-2
# Study material per document.
CARDS_PER_DOCUMENT_MAX=
QUESTIONS_PER_DOCUMENT_MAX=
# Testing only: make the mock AI return invalid output (summary|flashcards|quiz, or <part>-once).
# Ignored on Vercel production and on the production Neon branch.
AI_MOCK_FAIL=
# When the AI provider's DAILY quota resets (shown to users in their own time zone).
# Gemini free tier: midnight Pacific time. IANA zone + hour 0–23.
AI_LIMIT_RESET_TZ=America/Los_Angeles
AI_LIMIT_RESET_HOUR=0
# Testing only: 1 = every Gemini call acts as if the daily limit is used up.
# Ignored on Vercel production and on the production Neon branch.
AI_FORCE_DAILY_LIMIT=

# Chat with your course: user messages per hour (cost guard), and the max cosine
# distance for a passage to count as relevant (empty = 0.5 for Gemini, 0.95 mock).
CHAT_MAX_PER_HOUR=60
CHAT_MAX_DISTANCE=

# Daily reminder email (Resend). Without a key, development writes previews to
# .email-previews/ and production sends nothing. onboarding@resend.dev only
# delivers to your own Resend account email until you verify a domain.
RESEND_API_KEY=
EMAIL_FROM="Vappi <onboarding@resend.dev>"
# Local hour (0–21) the reminder goes out in each student's time zone.
REMINDER_HOUR=8
